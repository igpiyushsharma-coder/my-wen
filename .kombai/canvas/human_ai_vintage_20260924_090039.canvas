        "w": 1261,
        "h": 821
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap');\n.workbench{font-family:'IBM Plex Sans',sans-serif;color:#2B2925;background:#F4EFE6;min-height:100vh}.workbench .editorial{font-family:'Fraunces',Georgia,serif}.workbench .nav-link{display:flex;align-items:center;gap:13px;height:45px;padding:0 15px;color:#BDB1A5;border-radius:10px;font-size:13px;font-weight:500;transition:background .2s,color .2s}.workbench .nav-link:hover{background:#51443A;color:#F4EFE6}.workbench .nav-link.active{background:#59483B;color:#FFF7E9;position:relative}.workbench .nav-link.active:before{content:'';position:absolute;left:0;top:10px;bottom:10px;width:2px;background:#B08D57;border-radius:3px}.workbench svg{width:17px;height:17px;stroke-width:1.7;flex-shrink:0}.workbench .nav-link svg{width:17px;height:17px;color:#B9A692}.workbench .nav-link.active svg{color:#D0AA70}.workbench .field-label{display:block;font-size:12px;font-weight:600;color:#54483D;margin-bottom:9px}.workbench .form-control{display:block;width:100%;height:47px;padding:0 14px;background:#F8F4EC;border:1px solid #D5C7B6;border-radius:10px;color:#2B2925;font:500 14px 'IBM Plex Sans',sans-serif;outline:none;transition:border-color .2s,box-shadow .2s}.workbench .form-control:hover{border-color:#B5A28E}.workbench .form-control:focus{border-color:#A6533B;box-shadow:0 0 0 3px rgba(166,83,59,.14)}.workbench button:focus-visible,.workbench a:focus-visible,.workbench select:focus-visible,.workbench input:focus-visible{outline:2px solid #A6533B;outline-offset:3px}.workbench .primary{background:#A6533B;color:#FFF8F0;border:1px solid #A6533B;border-radius:10px;transition:background .2s,transform .2s;box-shadow:0 6px 14px rgba(88,44,31,.13)}.workbench .primary:hover{background:#8F422F;transform:translateY(-1px)}.workbench .primary:active{transform:translateY(0)}.workbench .stage{position:relative;min-width:0;flex:1;text-align:center}.workbench .stage:after{content:'';height:1px;background:#CFC0AC;position:absolute;left:calc(50% + 18px);right:calc(-50% + 18px);top:15px}.workbench .stage:last-child:after{display:none}.workbench .stage.current:after{background:linear-gradient(90deg,#A6533B,#CFC0AC)}.workbench .stage-num{position:relative;z-index:1;display:flex;align-items:center;justify-content:center;width:31px;height:31px;border-radius:50%;border:1px solid #CFC0AC;background:#F4EFE6;color:#817467;font-size:11px;font-weight:600;margin:auto auto 13px}.workbench .stage.current .stage-num{background:#A6533B;color:white;border-color:#A6533B;box-shadow:0 0 0 5px #F0E4D7}.workbench .stage-label{font-size:11px;font-weight:500;line-height:1.3;color:#8C8175}.workbench .stage.current .stage-label{color:#683E30;font-weight:700}.workbench .chart-line{height:1px;background:#DFD2C2}.workbench .card-lite{background:#F8F4EC;border:1px solid #DED2C3;border-radius:16px}.workbench .scenario-slot{background:#F7F2E9;border:1px solid #DED3C5;border-radius:14px}.workbench .nav-mobile{display:none}@media(max-width:980px){.workbench .desktop-rail{width:210px}.workbench .desktop-main{padding:28px}.workbench .columns{grid-template-columns:1fr!important}.workbench .left-panel{max-width:none!important}.workbench .evidence-grid{grid-template-columns:1fr 1fr!important}.workbench .decision-panel{grid-column:span 2}}@media(max-width:680px){.workbench .desktop-rail{display:none}.workbench .desktop-main{padding:18px 18px 102px}.workbench .topbar{display:none}.workbench .page-title{font-size:38px!important}.workbench .page-intro{font-size:14px!important}.workbench .columns{gap:18px!important}.workbench .left-panel{padding:23px!important}.workbench .right-panel{padding:23px!important}.workbench .stage-label{font-size:9px}.workbench .stage-num{width:26px;height:26px;font-size:9px}.workbench .stage:after{top:13px;left:calc(50% + 15px);right:calc(-50% + 15px)}.workbench .evidence-grid{grid-template-columns:1fr!important}.workbench .decision-panel{grid-column:auto}.workbench .nav-mobile{display:flex;position:fixed;bottom:0;left:0;right:0;height:72px;background:#3B3028;border-top:1px solid #625344;z-index:20;align-items:center;justify-content:space-around;padding:6px 8px env(safe-area-inset-bottom)}.workbench .nav-mobile a{color:#C8B8A8;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:3px;font-size:10px;min-width:58px;height:54px;border-radius:8px}.workbench .nav-mobile a.active{color:#F4EFE6;background:#59483B}.workbench .nav-mobile a.active svg{color:#C5A471}.workbench .result-preview{min-height:220px!important}.workbench .top-note{display:none}}\n</style>\n<script src=\"https://unpkg.com/lucide@latest/dist/umd/lucide.min.js\">\n</script>\n<div class=\"workbench flex\" data-kid=\"1\">\n    <aside aria-label=\"Primary navigation\" class=\"desktop-rail flex w-[248px] shrink-0 flex-col bg-[#3B3028] px-5 pb-7 pt-8 text-[#F4EFE6]\" data-kid=\"1-1\">\n        <div class=\"flex items-center gap-3 px-2\" data-kid=\"1-1-1\">\n            <div class=\"flex h-9 w-9 shrink-0 items-center justify-center rounded-[9px] border border-[#9D8265] bg-[#514236] text-[19px] text-[#EACBA6] editorial\" data-kid=\"1-1-1-1\">\n                H\n                <span class=\"text-[11px] not-italic mx-[1px]\" data-kid=\"1-1-1-1-1\">\n                    /\n                </span>\n                A\n            </div>\n            <div data-kid=\"1-1-1-2\">\n                <div class=\"text-[14px] font-semibold tracking-[-.02em] text-[#F6EEE2]\" data-kid=\"1-1-1-2-1\">\n                    Task Efficiency\n                </div>\n                <div class=\"text-[10px] font-semibold tracking-[.16em] text-[#BCA899]\" data-kid=\"1-1-1-2-2\">\n                    OPTIMIZER\n                </div>\n            </div>\n        </div>\n        <div class=\"mx-2 mt-12 border-t border-[#645449] pt-5 text-[10px] font-semibold tracking-[.14em] text-[#9D8D81]\" data-kid=\"1-1-2\">\n            WORKSPACE\n        </div>\n        <nav aria-label=\"Workspace\" class=\"mt-3 flex flex-col gap-1\" data-kid=\"1-1-3\">\n            <a class=\"nav-link\" data-kid=\"1-1-3-1\" href=\"#\">\n                <i data-kid=\"1-1-3-1-1\" data-lucide=\"layout-dashboard\">\n                </i>\n                Dashboard\n            </a>\n            <a class=\"nav-link\" data-kid=\"1-1-3-2\" href=\"#\">\n                <i data-kid=\"1-1-3-2-1\" data-lucide=\"list-checks\">\n                </i>\n                Tasks\n            </a>\n            <a aria-current=\"page\" class=\"nav-link active\" data-kid=\"1-1-3-3\" href=\"#\">\n                <i data-kid=\"1-1-3-3-1\" data-lucide=\"scale\">\n                </i>\n                Analysis\n            </a>\n            <a class=\"nav-link\" data-kid=\"1-1-3-4\" href=\"#\">\n                <i data-kid=\"1-1-3-4-1\" data-lucide=\"database\">\n                </i>\n                Data\n            </a>\n            <a class=\"nav-link\" data-kid=\"1-1-3-5\" href=\"#\">\n                <i data-kid=\"1-1-3-5-1\" data-lucide=\"sliders-horizontal\">\n                </i>\n                Settings\n            </a>\n        </nav>\n        <div class=\"mt-auto rounded-xl border border-[#68594B] bg-[#45382F] p-4\" data-kid=\"1-1-4\">\n            <div class=\"flex items-center gap-2 text-[11px] font-semibold text-[#EADDC8]\" data-kid=\"1-1-4-1\">\n                <i data-kid=\"1-1-4-1-1\" data-lucide=\"info\" style=\"width:15px;height:15px;color:#C2A476\">\n                </i>\n                Sample data mode\n            </div>\n            <p class=\"mb-0 mt-2 text-[11px] leading-[1.55] text-[#BAAA9C]\" data-kid=\"1-1-4-2\">\n                Benchmarks are illustrative. Import your own CSV records to compare real tasks.\n            </p>\n        </div>\n        <div class=\"mt-5 px-2 text-[10px] tracking-[.03em] text-[#97887B]\" data-kid=\"1-1-5\">\n            A better decision, by design.\n        </div>\n    </aside>\n    <main class=\"desktop-main min-w-0 flex-1 px-[43px] pb-12 pt-7\" data-kid=\"1-2\">\n        <div class=\"topbar flex items-center justify-between border-b border-[#DCCFBE] pb-5\" data-kid=\"1-2-1\">\n            <div class=\"flex items-center gap-2 text-[12px] text-[#837567]\" data-kid=\"1-2-1-1\">\n                <span data-kid=\"1-2-1-1-1\">\n                    Workspace\n                </span>\n                <i data-kid=\"1-2-1-1-2\" data-lucide=\"chevron-right\" style=\"width:13px;height:13px;color:#B2A08E\">\n                </i>\n                <span class=\"font-semibold text-[#3B3028]\" data-kid=\"1-2-1-1-3\">\n                    Task analysis\n                </span>\n            </div>\n            <div class=\"flex items-center gap-2 rounded-full border border-[#D6C7B2] px-3 py-[6px] text-[10px] font-semibold tracking-[.055em] text-[#715E4C]\" data-kid=\"1-2-1-2\">\n                <i data-kid=\"1-2-1-2-1\" data-lucide=\"flask-conical\" style=\"width:13px;height:13px;color:#A6533B\">\n                </i>\n                DEMO WORKSPACE\n            </div>\n        </div>\n        <header class=\"mb-[28px] mt-[34px] flex items-end justify-between gap-6\" data-kid=\"1-2-2\">\n            <div data-kid=\"1-2-2-1\">\n                <div class=\"mb-[8px] text-[11px] font-semibold uppercase tracking-[.13em] text-[#A6533B]\" data-kid=\"1-2-2-1-1\">\n                    Decision workbench\n                    <span class=\"ml-2 text-[#BEAF9D]\" data-kid=\"1-2-2-1-1-1\">\n                        / 01\n                    </span>\n                </div>\n                <h1 class=\"page-title editorial text-[43px] leading-[1.14] tracking-[-.045em] text-[#302922]\" data-kid=\"1-2-2-1-2\">\n                    Analyze a task\n                    <span class=\"text-[#A6533B]\" data-kid=\"1-2-2-1-2-1\">\n                        .\n                    </span>\n                </h1>\n                <p class=\"page-intro mb-0 mt-[10px] max-w-[570px] text-[14px] leading-[1.6] text-[#73695F]\" data-kid=\"1-2-2-1-3\">\n                    Set the conditions. We’ll compare stored Human and AI benchmarks, apply your quality requirement, and recommend the right workflow.\n                </p>\n            </div>\n            <div class=\"top-note mb-1 shrink-0 rounded-full bg-[#EAE0D1] px-3 py-[7px] text-[11px] font-medium text-[#756653]\" data-kid=\"1-2-2-2\">\n                01\n                <span class=\"mx-2 text-[#C5B5A3]\" data-kid=\"1-2-2-2-1\">\n                    /\n                </span>\n                Task input\n            </div>\n        </header>\n        <div class=\"columns grid grid-cols-[340px_minmax(0,1fr)] items-start gap-[19px]\" data-kid=\"1-2-3\">\n            <section aria-labelledby=\"conditions-title\" class=\"left-panel card-lite overflow-hidden p-[25px]\" data-kid=\"1-2-3-1\">\n                <div class=\"mb-5 flex items-center justify-between\" data-kid=\"1-2-3-1-1\">\n                    <div data-kid=\"1-2-3-1-1-1\">\n                        <div class=\"mb-2 text-[10px] font-semibold uppercase tracking-[.14em] text-[#A6533B]\" data-kid=\"1-2-3-1-1-1-1\">\n                            01 / INPUT\n                        </div>\n                        <h2 class=\"editorial text-[26px] leading-[1.2] tracking-[-.025em]\" data-kid=\"1-2-3-1-1-1-2\" id=\"conditions-title\">\n                            Task conditions\n                        </h2>\n                    </div>\n                    <div class=\"flex h-9 w-9 items-center justify-center rounded-[9px] bg-[#EBE0D0] text-[#745A47]\" data-kid=\"1-2-3-1-1-2\">\n                        <i data-kid=\"1-2-3-1-1-2-1\" data-lucide=\"sliders-horizontal\">\n                        </i>\n                    </div>\n                </div>\n                <div class=\"chart-line mb-6\" data-kid=\"1-2-3-1-2\">\n                </div>\n                <div class=\"mb-5\" data-kid=\"1-2-3-1-3\">\n                    <label class=\"field-label\" data-kid=\"1-2-3-1-3-1\" for=\"task-select\">\n                        Choose a task\n                    </label>\n                    <select class=\"form-control\" data-kid=\"1-2-3-1-3-2\" id=\"task-select\">\n                        <option data-kid=\"1-2-3-1-3-2-1\" selected=\"\" value=\"customer_email\">\n                            Customer email\n                        </option>\n                        <option data-kid=\"1-2-3-1-3-2-2\" value=\"data_extraction\">\n                            Data extraction\n                        </option>\n                        <option data-kid=\"1-2-3-1-3-2-3\" value=\"document_summary\">\n                            Document summary\n                        </option>\n                    </select>\n                    <p class=\"mb-0 mt-[9px] text-[12px] leading-[1.5] text-[#8A7B6D]\" data-dynamic=\"true\" data-kid=\"1-2-3-1-3-3\" data-name=\"task description text\" data-reason=\"text replaced based on select input by script\" id=\"task-description\">\n                        Replying to a routine customer support email.\n                    </p>\n                    <div class=\"mt-[9px] inline-flex rounded-full bg-[#EBE1D3] px-[9px] py-[4px] text-[10px] font-semibold text-[#66584B]\" data-dynamic=\"true\" data-kid=\"1-2-3-1-3-4\" data-name=\"task category label\" data-reason=\"text replaced based on select input by script\" id=\"task-category\">\n                        Customer Support\n                    </div>\n                </div>\n                <div class=\"chart-line mb-[21px]\" data-kid=\"1-2-3-1-4\">\n                </div>\n                <div class=\"mb-5\" data-kid=\"1-2-3-1-5\">\n                    <div class=\"flex items-center justify-between\" data-kid=\"1-2-3-1-5-1\">\n                        <label class=\"field-label\" data-kid=\"1-2-3-1-5-1-1\" for=\"volume-input\">\n                            Monthly task volume\n                        </label>\n                        <span class=\"mb-[9px] text-[11px] text-[#958678]\" data-kid=\"1-2-3-1-5-1-2\">\n                            tasks / month\n                        </span>\n                    </div>\n                    <input class=\"form-control\" data-kid=\"1-2-3-1-5-2\" id=\"volume-input\" inputmode=\"numeric\" min=\"0\" type=\"number\" value=\"10000\"/>\n                    <p class=\"mb-0 mt-[8px] text-[11px] leading-[1.5] text-[#8A7B6D]\" data-kid=\"1-2-3-1-5-3\">\n                        Used to project the monthly and yearly savings range.\n                    </p>\n                </div>\n                <div class=\"mb-6\" data-kid=\"1-2-3-1-6\">\n                    <div class=\"flex items-center justify-between\" data-kid=\"1-2-3-1-6-1\">\n                        <label class=\"field-label\" data-kid=\"1-2-3-1-6-1-1\" for=\"quality-input\">\n                            Minimum quality requirement\n                        </label>\n                        <span class=\"mb-[9px] text-[11px] text-[#958678]\" data-kid=\"1-2-3-1-6-1-2\">\n                            out of 10\n                        </span>\n                    </div>\n                    <div class=\"relative\" data-kid=\"1-2-3-1-6-2\">\n                        <input class=\"form-control pr-14\" data-kid=\"1-2-3-1-6-2-1\" id=\"quality-input\" inputmode=\"decimal\" max=\"10\" min=\"0\" step=\"0.5\" type=\"number\" value=\"7.0\"/>\n                        <span class=\"pointer-events-none absolute right-4 top-1/2 -translate-y-1/2 text-[13px] font-medium text-[#908173]\" data-kid=\"1-2-3-1-6-2-2\">\n                            / 10\n                        </span>\n                    </div>\n                    <div class=\"mt-[13px] flex items-start gap-2 rounded-[9px] bg-[#EEE8DD] px-3 py-[10px]\" data-kid=\"1-2-3-1-6-3\">\n                        <i data-kid=\"1-2-3-1-6-3-1\" data-lucide=\"shield-check\" style=\"width:15px;height:15px;color:#6F7352;margin-top:2px\">\n                        </i>\n                        <p class=\"mb-0 text-[11px] leading-[1.48] text-[#706557]\" data-kid=\"1-2-3-1-6-3-2\">\n                            A cheaper or faster option won’t be recommended if it falls below this quality floor.\n                        </p>\n                    </div>\n                </div>\n                <button aria-label=\"Run analysis\" class=\"primary flex h-[47px] w-full items-center justify-center gap-2 text-[13px] font-semibold\" data-kid=\"1-2-3-1-7\" type=\"button\">\n                    <i data-kid=\"1-2-3-1-7-1\" data-lucide=\"arrow-right\" style=\"width:16px;height:16px\">\n                    </i>\n                    Run analysis\n                </button>\n                <p class=\"mb-0 mt-[12px] text-center text-[11px] leading-[1.4] text-[#988879]\" data-kid=\"1-2-3-1-8\">\n                    Uses existing benchmark records · no data is changed\n                </p>\n            </section>\n            <section aria-labelledby=\"engine-title\" class=\"right-panel card-lite min-w-0 p-[27px]\" data-kid=\"1-2-3-2\">\n                <div class=\"flex items-start justify-between gap-4\" data-kid=\"1-2-3-2-1\">\n                    <div data-kid=\"1-2-3-2-1-1\">\n                        <div class=\"mb-[7px] text-[10px] font-semibold uppercase tracking-[.13em] text-[#85735D]\" data-kid=\"1-2-3-2-1-1-1\">\n                            THE ANALYSIS ENGINE\n                        </div>\n                        <h2 class=\"editorial text-[27px] tracking-[-.03em]\" data-kid=\"1-2-3-2-1-1-2\" id=\"engine-title\">\n                            From evidence to decision\n                        </h2>\n                    </div>\n                    <span class=\"shrink-0 rounded-full border border-[#D7C7B3] px-[10px] py-[5px] text-[10px] font-semibold text-[#7E6D5D]\" data-kid=\"1-2-3-2-1-2\">\n                        Ready to analyze\n                    </span>\n                </div>\n                <p class=\"mb-0 mt-2 text-[12px] leading-[1.6] text-[#887A6C]\" data-kid=\"1-2-3-2-2\">\n                    A transparent, quality-gated path to a recommendation—not automation by default.\n                </p>\n                <div class=\"chart-line my-[25px]\" data-kid=\"1-2-3-2-3\">\n                </div>\n                <div aria-label=\"Analysis stages\" class=\"flex w-full gap-0\" data-kid=\"1-2-3-2-4\">\n                    <div class=\"stage current\" data-kid=\"1-2-3-2-4-1\">\n                        <div class=\"stage-num\" data-kid=\"1-2-3-2-4-1-1\">\n                            01\n                        </div>\n                        <div class=\"stage-label\" data-kid=\"1-2-3-2-4-1-2\">\n                            Task\n                            <br data-kid=\"1-2-3-2-4-1-2-1\"/>\n                            input\n                        </div>\n                    </div>\n                    <div class=\"stage\" data-kid=\"1-2-3-2-4-2\">\n                        <div class=\"stage-num\" data-kid=\"1-2-3-2-4-2-1\">\n                            02\n                        </div>\n                        <div class=\"stage-label\" data-kid=\"1-2-3-2-4-2-2\">\n                            Benchmark\n                        </div>\n                    </div>\n                    <div class=\"stage\" data-kid=\"1-2-3-2-4-3\">\n                        <div class=\"stage-num\" data-kid=\"1-2-3-2-4-3-1\">\n                            03\n                        </div>\n                        <div class=\"stage-label\" data-kid=\"1-2-3-2-4-3-2\">\n                            Analysis\n                        </div>\n                    </div>\n                    <div class=\"stage\" data-kid=\"1-2-3-2-4-4\">\n                        <div class=\"stage-num\" data-kid=\"1-2-3-2-4-4-1\">\n                            04\n                        </div>\n                        <div class=\"stage-label\" data-kid=\"1-2-3-2-4-4-2\">\n                            Comparison\n                        </div>\n                    </div>\n                    <div class=\"stage\" data-kid=\"1-2-3-2-4-5\">\n                        <div class=\"stage-num\" data-kid=\"1-2-3-2-4-5-1\">\n                            05\n                        </div>\n                        <div class=\"stage-label\" data-kid=\"1-2-3-2-4-5-2\">\n                            Recommendation\n                        </div>\n                    </div>\n                </div>\n                <div class=\"chart-line mb-[22px] mt-[26px]\" data-kid=\"1-2-3-2-5\">\n                </div>\n                <div class=\"mb-3 flex items-center justify-between\" data-kid=\"1-2-3-2-6\">\n                    <h3 class=\"text-[13px] font-semibold tracking-[-.01em] text-[#3D342C]\" data-kid=\"1-2-3-2-6-1\">\n                        Benchmark evidence\n                    </h3>\n                    <div class=\"flex items-center gap-1.5 text-[10px] text-[#8D7E70]\" data-kid=\"1-2-3-2-6-2\">\n                        <i data-kid=\"1-2-3-2-6-2-1\" data-lucide=\"database\" style=\"width:12px;height:12px;color:#9B8876\">\n                        </i>\n                        Stored records\n                    </div>\n                </div>\n                <div class=\"evidence-grid grid grid-cols-2 gap-[10px]\" data-kid=\"1-2-3-2-7\">\n                    <div class=\"scenario-slot min-h-[132px] p-[15px]\" data-kid=\"1-2-3-2-7-1\">\n                        <div class=\"flex items-center justify-between\" data-kid=\"1-2-3-2-7-1-1\">\n                            <div class=\"flex items-center gap-2 text-[12px] font-semibold text-[#433830]\" data-kid=\"1-2-3-2-7-1-1-1\">\n                                <span class=\"h-[7px] w-[7px] rounded-full bg-[#3B3028]\" data-kid=\"1-2-3-2-7-1-1-1-1\">\n                                </span>\n                                Human benchmark\n                            </div>\n                            <i data-kid=\"1-2-3-2-7-1-1-2\" data-lucide=\"users-round\" style=\"width:15px;height:15px;color:#8A7663\">\n                            </i>\n                        </div>\n                        <div class=\"mt-4 space-y-[11px]\" data-kid=\"1-2-3-2-7-1-2\">\n                            <div class=\"h-[6px] w-[82%] rounded-full bg-[#DED2C3]\" data-kid=\"1-2-3-2-7-1-2-1\">\n                            </div>\n                            <div class=\"h-[6px] w-[57%] rounded-full bg-[#E5DBCD]\" data-kid=\"1-2-3-2-7-1-2-2\">\n                            </div>\n                        </div>\n                        <div class=\"mt-[13px] text-[10px] text-[#958678]\" data-kid=\"1-2-3-2-7-1-3\">\n                            Cost · Time · Quality rubric\n                        </div>\n                    </div>\n                    <div class=\"scenario-slot min-h-[132px] p-[15px]\" data-kid=\"1-2-3-2-7-2\">\n                        <div class=\"flex items-center justify-between\" data-kid=\"1-2-3-2-7-2-1\">\n                            <div class=\"flex items-center gap-2 text-[12px] font-semibold text-[#626A4C]\" data-kid=\"1-2-3-2-7-2-1-1\">\n                                <span class=\"h-[7px] w-[7px] rounded-full bg-[#6F7352]\" data-kid=\"1-2-3-2-7-2-1-1-1\">\n                                </span>\n                                AI benchmark\n                            </div>\n                            <i data-kid=\"1-2-3-2-7-2-1-2\" data-lucide=\"cpu\" style=\"width:15px;height:15px;color:#7A8060\">\n                            </i>\n                        </div>\n                        <div class=\"mt-4 space-y-[11px]\" data-kid=\"1-2-3-2-7-2-2\">\n                            <div class=\"h-[6px] w-[70%] rounded-full bg-[#D9DACB]\" data-kid=\"1-2-3-2-7-2-2-1\">\n                            </div>\n                            <div class=\"h-[6px] w-[61%] rounded-full bg-[#E0E2D5]\" data-kid=\"1-2-3-2-7-2-2-2\">\n                            </div>\n                        </div>\n                        <div class=\"mt-[13px] text-[10px] text-[#958678]\" data-kid=\"1-2-3-2-7-2-3\">\n                            Cost · Time · Quality rubric\n                        </div>\n                    </div>\n                    <div class=\"decision-panel col-span-2 mt-[2px] flex min-h-[98px] items-center justify-between gap-5 rounded-[13px] bg-[#3B3028] px-[18px] py-[16px] text-[#F4EFE6]\" data-kid=\"1-2-3-2-7-3\">\n                        <div data-kid=\"1-2-3-2-7-3-1\">\n                            <div class=\"mb-[5px] text-[10px] font-semibold uppercase tracking-[.12em] text-[#CDB995]\" data-kid=\"1-2-3-2-7-3-1-1\">\n                                DECISION GATE\n                            </div>\n                            <div class=\"text-[12px] leading-[1.5] text-[#E6D7C8]\" data-kid=\"1-2-3-2-7-3-1-2\">\n                                Weighted score + minimum quality requirement\n                            </div>\n                            <div class=\"mt-1 text-[11px] text-[#AD9B89]\" data-kid=\"1-2-3-2-7-3-1-3\">\n                                Outcome may be Human, AI, or Hybrid.\n                            </div>\n                        </div>\n                        <div class=\"flex h-9 w-9 shrink-0 items-center justify-center rounded-full border border-[#85715B] text-[#CBAB77]\" data-kid=\"1-2-3-2-7-3-2\">\n                            <i data-kid=\"1-2-3-2-7-3-2-1\" data-lucide=\"scale\" style=\"width:18px;height:18px;color:#CBAB77\">\n                            </i>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"result-preview mt-3 flex min-h-[145px] flex-col items-center justify-center rounded-[13px] border border-dashed border-[#D3C5B2] bg-[#F5F0E8] px-5 py-5 text-center\" data-kid=\"1-2-3-2-8\">\n                    <div class=\"mb-[9px] flex h-[31px] w-[31px] items-center justify-center rounded-full border border-[#CDBDAB] text-[#A18E79]\" data-kid=\"1-2-3-2-8-1\">\n                        <i data-kid=\"1-2-3-2-8-1-1\" data-lucide=\"bar-chart-3\" style=\"width:16px;height:16px;color:#A18E79\">\n                        </i>\n                    </div>\n                    <div class=\"text-[12px] font-semibold text-[#5A4C40]\" data-kid=\"1-2-3-2-8-2\">\n                        Your comparison will appear here\n                    </div>\n                    <p class=\"mb-0 mt-1 max-w-[345px] text-[11px] leading-[1.5] text-[#908173]\" data-kid=\"1-2-3-2-8-3\">\n                        Run an analysis to reveal the actual Human and AI values, routine and complex decisions, and a qualified savings range.\n                    </p>\n                </div>\n            </section>\n        </div>\n        <div class=\"mt-[18px] flex items-center gap-2 text-[11px] leading-[1.4] text-[#897B6B]\" data-kid=\"1-2-4\">\n            <i data-kid=\"1-2-4-1\" data-lucide=\"info\" style=\"width:14px;height:14px;color:#AA8A62\">\n            </i>\n            <span data-kid=\"1-2-4-2\">\n                Demo benchmarks are synthetic; results are decision-support estimates, not guaranteed outcomes.\n            </span>\n        </div>\n    </main>\n    <nav aria-label=\"Mobile navigation\" class=\"nav-mobile\" data-kid=\"1-3\">\n        <a data-kid=\"1-3-1\" href=\"#\">\n            <i data-kid=\"1-3-1-1\" data-lucide=\"layout-dashboard\">\n            </i>\n            Home\n        </a>\n        <a data-kid=\"1-3-2\" href=\"#\">\n            <i data-kid=\"1-3-2-1\" data-lucide=\"list-checks\">\n            </i>\n            Tasks\n        </a>\n        <a aria-current=\"page\" class=\"active\" data-kid=\"1-3-3\" href=\"#\">\n            <i data-kid=\"1-3-3-1\" data-lucide=\"scale\">\n            </i>\n            Analysis\n        </a>\n        <a data-kid=\"1-3-4\" href=\"#\">\n            <i data-kid=\"1-3-4-1\" data-lucide=\"database\">\n            </i>\n            Data\n        </a>\n        <a data-kid=\"1-3-5\" href=\"#\">\n            <i data-kid=\"1-3-5-1\" data-lucide=\"sliders-horizontal\">\n            </i>\n            Settings\n        </a>\n    </nav>\n</div>\n<script>\n    if(window.lucide) lucide.createIcons();\nconst taskSelect=document.getElementById('task-select');\nconst taskDescriptions={customer_email:['Replying to a routine customer support email.','Customer Support'],data_extraction:['Extracting structured fields (names, dates, amounts) from a document.','Data Entry'],document_summary:['Summarizing a business document into key points.','Content Processing']};\ntaskSelect.addEventListener('change',()=>{const [description,category]=taskDescriptions[taskSelect.value];document.getElementById('task-description').textContent=description;document.getElementById('task-category').textContent=category;});\n</script>\n",
