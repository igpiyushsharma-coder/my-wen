      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght,SOFT,WONK@9..144,400,0,0;9..144,500,0,0;9..144,600,0,0&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap');\n.bw {--ivory:#F4EFE6;--beige:#E7DCCB;--ink:#2B2925;--espresso:#3B3028;--terra:#A6533B;--olive:#6F7352;--gold:#B08D57;--gray:#8C8175;--rule:#D6C8B5;font-family:'IBM Plex Sans',sans-serif;background:var(--ivory);color:var(--ink);min-height:100vh;display:flex;font-size:14px;line-height:1.45}\n.bw .rail{width:224px;flex:none;background:var(--espresso);color:#F4EFE6;min-height:100vh;padding:27px 17px 24px;display:flex;flex-direction:column;position:relative}\n.bw .brand{display:flex;align-items:center;gap:11px;padding:0 8px 28px;border-bottom:1px solid rgba(244,239,230,.13)}\n.bw .brandmark{display:flex;align-items:center;justify-content:center;flex:none;width:34px;height:34px;border-radius:10px;background:var(--terra);color:#FFF9EF;font-family:'Fraunces',serif;font-size:18px;font-weight:600;letter-spacing:-.08em}\n.bw .brand-copy{font-weight:600;font-size:13px;line-height:1.14;letter-spacing:-.025em}.bw .brand-copy small{display:block;font-family:'IBM Plex Sans',sans-serif;font-size:10px;font-weight:500;letter-spacing:.1em;color:#C9B7A1;text-transform:uppercase;margin-top:3px}\n.bw .rail-cap{font-size:10px;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:#AC9A85;margin:34px 12px 11px}\n.bw nav{display:flex;flex-direction:column;gap:3px}.bw nav a{display:flex;align-items:center;gap:12px;text-decoration:none;padding:11px 12px;border-radius:9px;color:#C4B6A8;min-height:44px;font-size:13px;font-weight:500;transition:background .2s,color .2s}.bw nav a:hover{background:rgba(244,239,230,.08);color:#fff}.bw nav a.active{background:#594639;color:#FFF6E9;box-shadow:inset 2px 0 var(--gold)}.bw nav svg{width:17px;height:17px;stroke-width:1.8;flex:none}\n.bw .rail-bottom{margin-top:auto;padding:22px 10px 0;border-top:1px solid rgba(244,239,230,.13)}.bw .rail-bottom strong{font-size:12px;font-weight:600;color:#E9DCCB}.bw .rail-bottom p{font-size:11px;color:#B8A797;line-height:1.55;margin:6px 0 0}\n.bw .main{min-width:0;flex:1;padding:23px 31px 56px;background:var(--ivory)}\n.bw .topbar{display:flex;justify-content:space-between;align-items:center;padding:0 2px 20px}.bw .crumb{font-size:12px;color:#776D63;display:flex;align-items:center;gap:10px}.bw .crumb b{color:var(--ink);font-weight:600}.bw .top-right{display:flex;gap:10px;align-items:center}.bw .top-tag{border:1px solid var(--rule);border-radius:99px;padding:6px 10px;color:#63574B;font-size:11px;font-weight:600;display:flex;align-items:center;gap:7px}.bw .top-tag .square{width:6px;height:6px;border-radius:2px;background:var(--olive)}.bw .top-icon{width:31px;height:31px;border:1px solid var(--rule);border-radius:8px;display:grid;place-items:center;color:var(--espresso)}.bw .top-icon svg{width:15px;height:15px}\n.bw .hero{background:var(--espresso);border-radius:19px;min-height:259px;color:var(--ivory);display:grid;grid-template-columns:minmax(350px,1.03fr) minmax(385px,1fr);overflow:hidden;position:relative}.bw .hero:before{content:'';position:absolute;top:0;left:0;width:132px;height:2px;background:var(--gold)}.bw .hero-copy{padding:32px 20px 31px 37px;position:relative;z-index:1}.bw .eyebrow{display:flex;align-items:center;gap:9px;color:#CFBB9F;letter-spacing:.13em;text-transform:uppercase;font-size:10px;font-weight:700;margin-bottom:14px}.bw .eyebrow:before{content:'';width:15px;height:1px;background:var(--gold)}.bw .hero h1{font-family:'Fraunces',serif;font-size:clamp(32px,3.25vw,44px);line-height:1.08;font-weight:500;letter-spacing:-.042em;margin:0 0 11px;max-width:520px}.bw .hero h1 em{font-style:normal;color:#D8B19B}.bw .hero p{font-size:12.5px;line-height:1.55;color:#D8CFC4;max-width:450px;margin:0 0 21px}.bw .hero-actions{display:flex;gap:9px;align-items:center}.bw .btn{font-family:'IBM Plex Sans',sans-serif;border-radius:8px;min-height:37px;display:inline-flex;align-items:center;justify-content:center;gap:8px;padding:0 15px;cursor:pointer;font-size:12px;font-weight:600;transition:background .2s ease,transform .2s ease,border-color .2s ease}.bw .btn:hover{transform:translateY(-1px)}.bw .btn svg{width:15px;height:15px}.bw .btn-primary{border:1px solid #B85D44;background:var(--terra);color:#FFF7ED}.bw .btn-primary:hover{background:#91432E}.bw .btn-outline{border:1px solid #968578;background:transparent;color:#FFF3E6}.bw .btn-outline:hover{background:#5A493E}\n.bw .chain-wrap{padding:25px 30px 22px 4px;display:flex;flex-direction:column;justify-content:center}.bw .chain-head{display:flex;justify-content:space-between;align-items:center;color:#D7CABC;margin:0 0 12px;font-size:10px;text-transform:uppercase;letter-spacing:.11em;font-weight:600}.bw .chain-head span:last-child{color:#A99683;font-size:10px;letter-spacing:.02em;text-transform:none;font-weight:400}.bw .chain{position:relative;background:#473A30;border:1px solid #655449;border-radius:12px;padding:14px 16px 13px}.bw .chain-line{display:grid;grid-template-columns:1fr 21px 1fr 21px 1.13fr;align-items:center;gap:3px}.bw .chain-step{height:49px;border:1px solid #756052;background:#514035;border-radius:7px;display:flex;align-items:center;gap:8px;padding:0 9px;min-width:0}.bw .chain-step.olive{background:#505343;border-color:#777C5E}.bw .chain-step.gold{border-color:#9D835A;background:#594B3A}.bw .chain-step .dot{width:6px;height:6px;border-radius:50%;background:#DED1BE;flex:none}.bw .chain-step.olive .dot{background:#A9B18A}.bw .chain-step.gold .dot{background:#D4AD68}.bw .chain-step strong{display:block;font-size:11px;font-weight:600;color:#F4EEE2;white-space:nowrap}.bw .chain-step small{display:block;font-size:9px;color:#B9AB9B;margin-top:2px;white-space:nowrap}.bw .connector{height:1px;background:#A38965;position:relative;animation:draw .8s ease-out both;transform-origin:left}.bw .connector:after{content:'';position:absolute;right:0;top:-2px;width:4px;height:4px;border-right:1px solid #A38965;border-top:1px solid #A38965;transform:rotate(45deg)}@keyframes draw{from{transform:scaleX(0)}to{transform:scaleX(1)}}.bw .chain-footer{display:flex;align-items:center;gap:6px;margin-top:12px;color:#C6BAAB;font-size:10px}.bw .chain-footer b{color:#E3C08F;font-weight:600}.bw .chain-footer svg{width:13px;height:13px;color:#D0AC70}.bw .chain-caption{display:flex;align-items:center;gap:6px;margin-top:12px;font-size:11px;color:#BFAF9D}.bw .chain-caption span{display:inline-block;width:5px;height:5px;border-radius:50%;background:#C17B5F}\n.bw .register-title{display:flex;justify-content:space-between;align-items:end;margin:26px 0 12px;padding:0 2px}.bw h2{font-family:'Fraunces',serif;font-size:25px;font-weight:500;letter-spacing:-.035em;margin:0;line-height:1.2}.bw .register-title p{font-size:11px;color:#74685B;margin:4px 0 0}.bw .register-title .source{color:#706456;font-size:11px;border-bottom:1px solid var(--rule);padding-bottom:3px}\n.bw .register{border:1px solid #D5C7B6;border-radius:17px;background:#F8F4ED;overflow:hidden;box-shadow:0 10px 32px rgba(65,48,36,.035)}.bw .register-metrics{display:grid;grid-template-columns:repeat(4,1fr) 1.34fr;border-bottom:1px solid var(--rule)}.bw .metric{padding:19px 19px 18px;min-height:91px;border-right:1px solid var(--rule)}.bw .metric:last-child{border-right:0}.bw .metric.gold{background:#F0E6D4}.bw .metric .metric-label{font-size:10px;color:#71675B;white-space:nowrap}.bw .metric .metric-value{font-family:'Fraunces',serif;font-size:29px;letter-spacing:-.045em;line-height:1.08;margin:6px 0 0;color:var(--espresso)}.bw .metric.ai .metric-value{color:var(--olive)}.bw .metric.hybrid .metric-value{color:var(--terra)}.bw .metric.gold .metric-value{font-size:25px;color:#6D4E2F}.bw .metric .metric-note{font-size:9px;color:#8A7968;margin-top:4px}\n.bw .register-body{display:grid;grid-template-columns:minmax(0,1.58fr) minmax(286px,1fr);min-height:338px}.bw .chart-panel{padding:23px 23px 19px;border-right:1px solid var(--rule)}.bw .chart-header{display:flex;align-items:center;justify-content:space-between;gap:12px}.bw .chart-heading{font-size:15px;font-weight:600;letter-spacing:-.02em}.bw .chart-sub{font-size:10px;color:#86786A;margin:5px 0 0}.bw .chart-tabs{display:flex;border:1px solid var(--rule);border-radius:8px;padding:3px;background:#F1EAE0}.bw .chart-tabs button{border:0;background:transparent;color:#71675D;border-radius:5px;padding:6px 10px;font:600 10px 'IBM Plex Sans',sans-serif;cursor:pointer;transition:background .2s,color .2s}.bw .chart-tabs button.active{background:var(--espresso);color:var(--ivory)}.bw .legend{display:flex;gap:14px;margin-top:17px;color:#695F55;font-size:10px}.bw .legend span{display:inline-flex;align-items:center;gap:6px}.bw .legend span:before{content:'';display:inline-block;width:7px;height:7px;border-radius:2px;background:var(--espresso)}.bw .legend span:nth-child(2):before{background:var(--olive)}\n.bw .plot{margin-top:16px;display:flex;flex-direction:column;gap:13px}.bw .plot-row{display:grid;grid-template-columns:125px minmax(0,1fr) 87px;align-items:center;gap:13px}.bw .plot-row .task-name{font-size:11px;color:#544B42;font-weight:500;line-height:1.2}.bw .plot-row .bars{display:flex;flex-direction:column;gap:5px}.bw .plot-row .track{height:8px;border-radius:4px;background:#EAE0D4;overflow:hidden}.bw .plot-row .bar{height:100%;border-radius:4px;min-width:2px;transition:width .4s ease}.bw .plot-row .bar.human{background:var(--espresso)}.bw .plot-row .bar.ai{background:var(--olive)}.bw .plot-row .pair{font-size:10px;color:#665B51;text-align:right;font-variant-numeric:tabular-nums;white-space:nowrap;line-height:1.65}.bw .plot-row .pair b{font-weight:600;color:var(--espresso)}.bw .plot-row .pair i{font-style:normal;color:var(--olive)}.bw .chart-foot{margin-top:17px;padding-top:10px;border-top:1px solid var(--rule);font-size:10px;color:#7F7062;line-height:1.45}\n.bw .insights{display:flex;flex-direction:column}.bw .insight-block{padding:22px 23px 18px;flex:1}.bw .insight-block + .insight-block{border-top:1px solid var(--rule)}.bw .insight-head{display:flex;align-items:baseline;justify-content:space-between;gap:8px}.bw .insight-head strong{font-size:13px;font-weight:600}.bw .insight-head span{font-size:10px;color:#7F7162}.bw .distribution{margin-top:14px;display:flex;height:11px;border-radius:5px;overflow:hidden;background:#E9DED1}.bw .distribution .human{width:66.666%;background:var(--espresso)}.bw .distribution .ai{width:33.334%;background:var(--olive)}.bw .distribution .hybrid{width:0%;background:var(--terra)}.bw .distribution-list{display:flex;flex-wrap:wrap;gap:6px 13px;margin-top:13px}.bw .distribution-list span{font-size:10px;color:#62584F}.bw .distribution-list b{color:var(--espresso);font-weight:600}.bw .distribution-list span:before{content:'';display:inline-block;width:6px;height:6px;border-radius:2px;background:var(--espresso);margin-right:5px}.bw .distribution-list span:nth-child(2):before{background:var(--olive)}.bw .distribution-list span:nth-child(3):before{background:var(--terra)}.bw .insight-copy{font-size:10px;color:#7B6E62;line-height:1.45;margin:10px 0 0}.bw .quality-line{display:flex;align-items:center;gap:8px;margin:14px 0 12px;font-size:11px;color:#584E43}.bw .quality-line:before{content:'';height:1px;flex:1;background:var(--gold);order:2}.bw .quality-line strong{font-family:'Fraunces',serif;font-size:20px;color:#6D593E;order:3;font-weight:500}.bw .quality-line span{order:1}.bw .sample-count{display:flex;align-items:center;gap:8px;margin:0;color:#6C6054;font-size:11px}.bw .sample-count svg{width:14px;height:14px;color:var(--olive)}\n.bw .footer-note{margin:14px 3px 0;color:#75685B;font-size:11px;line-height:1.6;display:flex;align-items:start;gap:7px}.bw .footer-note svg{width:14px;height:14px;flex:none;margin-top:2px;color:var(--terra)}\n.bw .mobile-nav{display:none}\n@media(max-width:1050px){.bw .rail{width:195px}.bw .main{padding:22px 21px 48px}.bw .hero{grid-template-columns:1fr 1fr}.bw .chain-wrap{padding-right:15px}.bw .chain-step{padding:0 5px;gap:5px}.bw .chain-step strong{font-size:9px}.bw .chain-step small{font-size:8px}.bw .plot-row{grid-template-columns:105px minmax(0,1fr) 80px;gap:7px}}\n@media(max-width:760px){.bw{display:block;padding-bottom:66px}.bw .rail{display:none}.bw .main{padding:17px 16px 35px}.bw .topbar{padding-bottom:14px}.bw .hero{display:block}.bw .hero-copy{padding:26px 25px 22px}.bw .hero h1{font-size:38px}.bw .chain-wrap{padding:0 20px 22px}.bw .chain-step{padding:0 8px}.bw .chain-step strong{font-size:10px}.bw .chain-step small{font-size:8px}.bw .register-metrics{grid-template-columns:repeat(2,1fr)}.bw .metric{border-bottom:1px solid var(--rule)}.bw .metric:nth-child(2n){border-right:0}.bw .metric.gold{grid-column:span 2;border-bottom:0}.bw .register-body{display:block}.bw .chart-panel{border-right:0;border-bottom:1px solid var(--rule)}.bw .register-title .source{display:none}.bw .mobile-nav{display:flex;position:fixed;left:0;bottom:0;right:0;background:var(--espresso);border-top:1px solid #695549;z-index:20;justify-content:space-around;padding:7px 4px 8px}.bw .mobile-nav a{font-size:9px;display:flex;flex-direction:column;align-items:center;gap:2px;color:#B9AA9C;text-decoration:none;min-width:57px}.bw .mobile-nav a.active{color:#FFF7EC}.bw .mobile-nav svg{width:18px;height:18px}.bw .mobile-nav a.active svg{color:#D6B579}}\n@media(max-width:440px){.bw .hero h1{font-size:35px}.bw .hero-actions{flex-wrap:wrap}.bw .chain-line{grid-template-columns:1fr 12px 1fr 12px 1.13fr}.bw .chain-step{padding:0 4px;gap:3px}.bw .chain-step .dot{width:4px;height:4px}.bw .chain-step strong{font-size:9px}.bw .chain-step small{font-size:7px}.bw .chart-header{align-items:start}.bw .chart-tabs button{padding:6px 8px}.bw .plot-row{grid-template-columns:87px minmax(0,1fr) 73px;gap:6px}.bw .plot-row .task-name{font-size:10px}.bw .plot-row .pair{font-size:9px}.bw .metric{padding:15px}.bw .metric .metric-value{font-size:25px}}\n@media(prefers-reduced-motion:reduce){.bw .connector{animation:none}.bw .plot-row .bar,.bw .btn{transition:none}}\n</style>\n<div class=\"bw\" data-kid=\"1\">\n    <aside aria-label=\"Primary navigation\" class=\"rail\" data-kid=\"1-1\">\n        <div class=\"brand\" data-kid=\"1-1-1\">\n            <span class=\"brandmark\" data-kid=\"1-1-1-1\">\n                H·A\n            </span>\n            <div class=\"brand-copy\" data-kid=\"1-1-1-2\">\n                Task Efficiency\n                <small data-kid=\"1-1-1-2-1\">\n                    Optimizer\n                </small>\n            </div>\n        </div>\n        <div class=\"rail-cap\" data-kid=\"1-1-2\">\n            Workspace\n        </div>\n        <nav aria-label=\"Main\" data-kid=\"1-1-3\">\n            <a aria-current=\"page\" class=\"active\" data-kid=\"1-1-3-1\" href=\"javascript:void(0)\">\n                <i data-kid=\"1-1-3-1-1\" data-lucide=\"layout-dashboard\" style=\"width:17px;height:17px;color:inherit\">\n                </i>\n                Dashboard\n            </a>\n            <a data-kid=\"1-1-3-2\" href=\"javascript:void(0)\">\n                <i data-kid=\"1-1-3-2-1\" data-lucide=\"list-checks\" style=\"width:17px;height:17px;color:inherit\">\n                </i>\n                Tasks\n            </a>\n            <a data-kid=\"1-1-3-3\" href=\"javascript:void(0)\">\n                <i data-kid=\"1-1-3-3-1\" data-lucide=\"scan-search\" style=\"width:17px;height:17px;color:inherit\">\n                </i>\n                Analysis\n            </a>\n            <a data-kid=\"1-1-3-4\" href=\"javascript:void(0)\">\n                <i data-kid=\"1-1-3-4-1\" data-lucide=\"database\" style=\"width:17px;height:17px;color:inherit\">\n                </i>\n                Data\n            </a>\n            <a data-kid=\"1-1-3-5\" href=\"javascript:void(0)\">\n                <i data-kid=\"1-1-3-5-1\" data-lucide=\"sliders-horizontal\" style=\"width:17px;height:17px;color:inherit\">\n                </i>\n                Settings\n            </a>\n        </nav>\n        <div class=\"rail-bottom\" data-kid=\"1-1-4\">\n            <strong data-kid=\"1-1-4-1\">\n                Built for better decisions.\n            </strong>\n            <p data-kid=\"1-1-4-2\">\n                Cost + time + quality.\n                <br data-kid=\"1-1-4-2-1\"/>\n                Quality can veto the score.\n            </p>\n            <p data-kid=\"1-1-4-3\">\n                Sample data mode · Illustrative only\n            </p>\n        </div>\n    </aside>\n    <main class=\"main\" data-kid=\"1-2\">\n        <div class=\"topbar\" data-kid=\"1-2-1\">\n            <div class=\"crumb\" data-kid=\"1-2-1-1\">\n                Workspace\n                <span data-kid=\"1-2-1-1-1\" style=\"color:#B4A89A\">\n                    /\n                </span>\n                <b data-kid=\"1-2-1-1-2\">\n                    Dashboard\n                </b>\n            </div>\n            <div class=\"top-right\" data-kid=\"1-2-1-2\">\n                <span class=\"top-tag\" data-kid=\"1-2-1-2-1\">\n                    <span class=\"square\" data-kid=\"1-2-1-2-1-1\">\n                    </span>\n                    Demo dataset\n                </span>\n                <span aria-label=\"Information\" class=\"top-icon\" data-kid=\"1-2-1-2-2\">\n                    <i data-kid=\"1-2-1-2-2-1\" data-lucide=\"circle-help\" style=\"width:15px;height:15px;color:#3B3028\">\n                    </i>\n                </span>\n            </div>\n        </div>\n        <section aria-labelledby=\"hero-title\" class=\"hero\" data-kid=\"1-2-2\">\n            <div class=\"hero-copy\" data-kid=\"1-2-2-1\">\n                <div class=\"eyebrow\" data-kid=\"1-2-2-1-1\">\n                    The decision workbench\n                </div>\n                <h1 data-kid=\"1-2-2-1-2\" id=\"hero-title\">\n                    Know Before You\n                    <em data-kid=\"1-2-2-1-2-1\">\n                        Automate.\n                    </em>\n                </h1>\n                <p data-kid=\"1-2-2-1-3\">\n                    Compare Human, AI and Hybrid workflows to discover the most efficient way to complete every task.\n                </p>\n                <div class=\"hero-actions\" data-kid=\"1-2-2-1-4\">\n                    <button class=\"btn btn-primary\" data-kid=\"1-2-2-1-4-1\" type=\"button\">\n                        Analyze a Task\n                        <i data-kid=\"1-2-2-1-4-1-1\" data-lucide=\"arrow-up-right\" style=\"width:15px;height:15px;color:#FFF7ED\">\n                        </i>\n                    </button>\n                    <button class=\"btn btn-outline\" data-kid=\"1-2-2-1-4-2\" type=\"button\">\n                        Explore Demo\n                        <i data-kid=\"1-2-2-1-4-2-1\" data-lucide=\"arrow-right\" style=\"width:15px;height:15px;color:#FFF3E6\">\n                        </i>\n                    </button>\n                </div>\n            </div>\n            <div class=\"chain-wrap\" data-kid=\"1-2-2-2\">\n                <div class=\"chain-head\" data-kid=\"1-2-2-2-1\">\n                    <span data-kid=\"1-2-2-2-1-1\">\n                        How a decision is made\n                    </span>\n                    <span data-kid=\"1-2-2-2-1-2\">\n                        Evidence, not assumption\n                    </span>\n                </div>\n                <div class=\"chain\" data-kid=\"1-2-2-2-2\">\n                    <div class=\"chain-line\" data-kid=\"1-2-2-2-2-1\">\n                        <div class=\"chain-step\" data-kid=\"1-2-2-2-2-1-1\">\n                            <span class=\"dot\" data-kid=\"1-2-2-2-2-1-1-1\">\n                            </span>\n                            <span data-kid=\"1-2-2-2-2-1-1-2\">\n                                <strong data-kid=\"1-2-2-2-2-1-1-2-1\">\n                                    Human\n                                </strong>\n                                <small data-kid=\"1-2-2-2-2-1-1-2-2\">\n                                    Benchmark\n                                </small>\n                            </span>\n                        </div>\n                        <span class=\"connector\" data-kid=\"1-2-2-2-2-1-2\">\n                        </span>\n                        <div class=\"chain-step olive\" data-kid=\"1-2-2-2-2-1-3\">\n                            <span class=\"dot\" data-kid=\"1-2-2-2-2-1-3-1\">\n                            </span>\n                            <span data-kid=\"1-2-2-2-2-1-3-2\">\n                                <strong data-kid=\"1-2-2-2-2-1-3-2-1\">\n                                    AI\n                                </strong>\n                                <small data-kid=\"1-2-2-2-2-1-3-2-2\">\n                                    Benchmark\n                                </small>\n                            </span>\n                        </div>\n                        <span class=\"connector\" data-kid=\"1-2-2-2-2-1-4\" style=\"animation-delay:.25s\">\n                        </span>\n                        <div class=\"chain-step gold\" data-kid=\"1-2-2-2-2-1-5\">\n                            <span class=\"dot\" data-kid=\"1-2-2-2-2-1-5-1\">\n                            </span>\n                            <span data-kid=\"1-2-2-2-2-1-5-2\">\n                                <strong data-kid=\"1-2-2-2-2-1-5-2-1\">\n                                    Quality\n                                </strong>\n                                <small data-kid=\"1-2-2-2-2-1-5-2-2\">\n                                    Decision gate\n                                </small>\n                            </span>\n                        </div>\n                    </div>\n                    <div class=\"chain-footer\" data-kid=\"1-2-2-2-2-2\">\n                        <i data-kid=\"1-2-2-2-2-2-1\" data-lucide=\"corner-down-right\" style=\"width:13px;height:13px;color:#D0AC70\">\n                        </i>\n                        Then recommend\n                        <b data-kid=\"1-2-2-2-2-2-2\">\n                            Human · AI · Hybrid\n                        </b>\n                    </div>\n                </div>\n                <div class=\"chain-caption\" data-kid=\"1-2-2-2-3\">\n                    <span data-kid=\"1-2-2-2-3-1\">\n                    </span>\n                    Cost  ·  Time  ·  Quality  ·  Efficiency\n                </div>\n            </div>\n        </section>\n        <div class=\"register-title\" data-kid=\"1-2-3\">\n            <div data-kid=\"1-2-3-1\">\n                <h2 data-kid=\"1-2-3-1-1\">\n                    Benchmark overview\n                </h2>\n                <p data-kid=\"1-2-3-1-2\">\n                    A compact view of the current task dataset and its decision patterns.\n                </p>\n            </div>\n            <span class=\"source\" data-kid=\"1-2-3-2\">\n                Based on 3 sample tasks\n            </span>\n        </div>\n        <section aria-label=\"Benchmark overview\" class=\"register\" data-kid=\"1-2-4\">\n            <div class=\"register-metrics\" data-kid=\"1-2-4-1\">\n                <div class=\"metric\" data-kid=\"1-2-4-1-1\">\n                    <div class=\"metric-label\" data-kid=\"1-2-4-1-1-1\">\n                        Tasks analyzed\n                    </div>\n                    <div class=\"metric-value\" data-kid=\"1-2-4-1-1-2\">\n                        03\n                    </div>\n                </div>\n                <div class=\"metric\" data-kid=\"1-2-4-1-2\">\n                    <div class=\"metric-label\" data-kid=\"1-2-4-1-2-1\">\n                        Human recommended\n                    </div>\n                    <div class=\"metric-value\" data-kid=\"1-2-4-1-2-2\">\n                        02\n                    </div>\n                </div>\n                <div class=\"metric ai\" data-kid=\"1-2-4-1-3\">\n                    <div class=\"metric-label\" data-kid=\"1-2-4-1-3-1\">\n                        AI recommended\n                    </div>\n                    <div class=\"metric-value\" data-kid=\"1-2-4-1-3-2\">\n                        01\n                    </div>\n                </div>\n                <div class=\"metric hybrid\" data-kid=\"1-2-4-1-4\">\n                    <div class=\"metric-label\" data-kid=\"1-2-4-1-4-1\">\n                        Hybrid recommended\n                    </div>\n                    <div class=\"metric-value\" data-kid=\"1-2-4-1-4-2\">\n                        00\n                    </div>\n                </div>\n                <div class=\"metric gold\" data-kid=\"1-2-4-1-5\">\n                    <div class=\"metric-label\" data-kid=\"1-2-4-1-5-1\">\n                        Hypothetical AI cost difference / mo.\n                    </div>\n                    <div class=\"metric-value\" data-kid=\"1-2-4-1-5-2\">\n                        ₹5,71,274\n                    </div>\n                    <div class=\"metric-note\" data-kid=\"1-2-4-1-5-3\">\n                        Unconstrained switch scenario · not realized savings\n                    </div>\n                </div>\n            </div>\n            <div class=\"register-body\" data-kid=\"1-2-4-2\">\n                <div class=\"chart-panel\" data-kid=\"1-2-4-2-1\">\n                    <div class=\"chart-header\" data-kid=\"1-2-4-2-1-1\">\n                        <div data-kid=\"1-2-4-2-1-1-1\">\n                            <div class=\"chart-heading\" data-kid=\"1-2-4-2-1-1-1-1\">\n                                Human vs AI benchmarks\n                            </div>\n                            <p class=\"chart-sub\" data-kid=\"1-2-4-2-1-1-1-2\">\n                                Average per task · switch metric to compare exact values\n                            </p>\n                        </div>\n                        <div aria-label=\"Comparison metric\" class=\"chart-tabs\" data-kid=\"1-2-4-2-1-1-2\" role=\"tablist\">\n                            <button aria-selected=\"true\" class=\"active\" data-kid=\"1-2-4-2-1-1-2-1\" data-metric=\"quality\" role=\"tab\">\n                                Quality\n                            </button>\n                            <button aria-selected=\"false\" data-kid=\"1-2-4-2-1-1-2-2\" data-metric=\"cost\" role=\"tab\">\n                                Cost\n                            </button>\n                            <button aria-selected=\"false\" data-kid=\"1-2-4-2-1-1-2-3\" data-metric=\"time\" role=\"tab\">\n                                Time\n                            </button>\n                        </div>\n                    </div>\n                    <div class=\"legend\" data-kid=\"1-2-4-2-1-2\">\n                        <span data-kid=\"1-2-4-2-1-2-1\">\n                            Human\n                        </span>\n                        <span data-kid=\"1-2-4-2-1-2-2\">\n                            AI\n                        </span>\n                    </div>\n                    <div aria-live=\"polite\" class=\"plot\" data-dynamic=\"true\" data-kid=\"1-2-4-2-1-3\" data-name=\"benchmark comparison bar chart\" data-reason=\"bars re-rendered on tab switch by script\" id=\"bw-plot\">\n                    </div>\n                    <div class=\"chart-foot\" data-dynamic=\"true\" data-kid=\"1-2-4-2-1-4\" data-name=\"benchmark chart footer description\" data-reason=\"text content updated on tab switch by script\" id=\"bw-chart-foot\">\n                        Quality is scored out of 10. A cheaper or faster option may still fail the minimum quality requirement.\n                    </div>\n                </div>\n                <div class=\"insights\" data-kid=\"1-2-4-2-2\">\n                    <div class=\"insight-block\" data-kid=\"1-2-4-2-2-1\">\n                        <div class=\"insight-head\" data-kid=\"1-2-4-2-2-1-1\">\n                            <strong data-kid=\"1-2-4-2-2-1-1-1\">\n                                Recommendation distribution\n                            </strong>\n                            <span data-kid=\"1-2-4-2-2-1-1-2\">\n                                Across 3 tasks\n                            </span>\n                        </div>\n                        <div aria-label=\"2 Human, 1 AI, 0 Hybrid recommended\" class=\"distribution\" data-kid=\"1-2-4-2-2-1-2\" role=\"img\">\n                            <div class=\"human\" data-kid=\"1-2-4-2-2-1-2-1\">\n                            </div>\n                            <div class=\"ai\" data-kid=\"1-2-4-2-2-1-2-2\">\n                            </div>\n                            <div class=\"hybrid\" data-kid=\"1-2-4-2-2-1-2-3\">\n                            </div>\n                        </div>\n                        <div class=\"distribution-list\" data-kid=\"1-2-4-2-2-1-3\">\n                            <span data-kid=\"1-2-4-2-2-1-3-1\">\n                                Human\n                                <b data-kid=\"1-2-4-2-2-1-3-1-1\">\n                                    2\n                                </b>\n                            </span>\n                            <span data-kid=\"1-2-4-2-2-1-3-2\">\n                                AI\n                                <b data-kid=\"1-2-4-2-2-1-3-2-1\">\n                                    1\n                                </b>\n                            </span>\n                            <span data-kid=\"1-2-4-2-2-1-3-3\">\n                                Hybrid\n                                <b data-kid=\"1-2-4-2-2-1-3-3-1\">\n                                    0\n                                </b>\n                            </span>\n                        </div>\n                        <p class=\"insight-copy\" data-kid=\"1-2-4-2-2-1-4\">\n                            There is no automatic AI winner. The recommended workflow depends on each task and its quality requirement.\n                        </p>\n                    </div>\n                    <div class=\"insight-block\" data-kid=\"1-2-4-2-2-2\">\n                        <div class=\"insight-head\" data-kid=\"1-2-4-2-2-2-1\">\n                            <strong data-kid=\"1-2-4-2-2-2-1-1\">\n                                Benchmark confidence context\n                            </strong>\n                            <span data-kid=\"1-2-4-2-2-2-1-2\">\n                                Sample dataset\n                            </span>\n                        </div>\n                        <div class=\"quality-line\" data-kid=\"1-2-4-2-2-2-2\">\n                            <span data-kid=\"1-2-4-2-2-2-2-1\">\n                                Minimum quality threshold\n                            </span>\n                            <strong data-kid=\"1-2-4-2-2-2-2-2\">\n                                7.0/10\n                            </strong>\n                        </div>\n                        <div class=\"sample-count\" data-kid=\"1-2-4-2-2-2-3\">\n                            <i data-kid=\"1-2-4-2-2-2-3-1\" data-lucide=\"files\" style=\"width:14px;height:14px;color:#6F7352\">\n                            </i>\n                            60 Human records  ·  60 AI runs\n                        </div>\n                        <p class=\"insight-copy\" data-kid=\"1-2-4-2-2-2-4\">\n                            Synthetic observations are for demonstration. More real-world data can improve the reliability of recommendations.\n                        </p>\n                    </div>\n                </div>\n            </div>\n        </section>\n        <div class=\"footer-note\" data-kid=\"1-2-5\">\n            <i data-kid=\"1-2-5-1\" data-lucide=\"info\" style=\"width:14px;height:14px;color:#A6533B\">\n            </i>\n            <span data-kid=\"1-2-5-2\">\n                Estimates compare Human and AI benchmark costs at 10,000 tasks/month per task. They do not account for quality-gated eligibility or represent achieved savings. Run a task analysis to see the actual recommendation and savings range.\n            </span>\n        </div>\n    </main>\n    <nav aria-label=\"Mobile navigation\" class=\"mobile-nav\" data-kid=\"1-3\">\n        <a aria-current=\"page\" class=\"active\" data-kid=\"1-3-1\" href=\"javascript:void(0)\">\n            <i data-kid=\"1-3-1-1\" data-lucide=\"layout-dashboard\" style=\"width:18px;height:18px;color:inherit\">\n            </i>\n            Dashboard\n        </a>\n        <a data-kid=\"1-3-2\" href=\"javascript:void(0)\">\n            <i data-kid=\"1-3-2-1\" data-lucide=\"list-checks\" style=\"width:18px;height:18px;color:inherit\">\n            </i>\n            Tasks\n        </a>\n        <a data-kid=\"1-3-3\" href=\"javascript:void(0)\">\n            <i data-kid=\"1-3-3-1\" data-lucide=\"scan-search\" style=\"width:18px;height:18px;color:inherit\">\n            </i>\n            Analysis\n        </a>\n        <a data-kid=\"1-3-4\" href=\"javascript:void(0)\">\n            <i data-kid=\"1-3-4-1\" data-lucide=\"database\" style=\"width:18px;height:18px;color:inherit\">\n            </i>\n            Data\n        </a>\n        <a data-kid=\"1-3-5\" href=\"javascript:void(0)\">\n            <i data-kid=\"1-3-5-1\" data-lucide=\"sliders-horizontal\" style=\"width:18px;height:18px;color:inherit\">\n            </i>\n            Settings\n        </a>\n    </nav>\n</div>\n<script src=\"https://unpkg.com/lucide@latest/dist/umd/lucide.min.js\">\n</script>\n<script>\n    (function(){\n if(window.lucide) lucide.createIcons();\n const data={\n quality:{max:10,rows:[['Customer support email',8.1,6.7],['Data extraction',7.8,7.0],['Document summary',7.8,6.8]],format:v=>v.toFixed(1)+'/10',note:'Quality is scored out of 10. A cheaper or faster option may still fail the minimum quality requirement.'},\n cost:{max:32,rows:[['Customer support email',14.55,.0989],['Data extraction',12.2,.11],['Document summary',30.0,.20]],format:v=>'₹'+(v<1?v.toFixed(2):v.toFixed(2)),note:'Bars share one scale. Tiny AI costs are shown to scale; exact task-specific values are available in Analysis. Preview values are illustrative.'},\n time:{max:600,rows:[['Customer support email',401.4,4.5],['Data extraction',307,4.2],['Document summary',551,7.2]],format:v=>v.toFixed(1)+'s',note:'Bars share one scale. Time is in seconds per task; this preview is illustrative. Recommendations still depend on quality.'}\n };\n const plot=document.getElementById('bw-plot'),foot=document.getElementById('bw-chart-foot');\n function show(metric){const m=data[metric];plot.innerHTML=m.rows.map(([label,h,a])=>`<div class=\"plot-row\"><span class=\"task-name\">${label}</span><div class=\"bars\"><div class=\"track\"><div class=\"bar human\" style=\"width:${100*h/m.max}%\"></div></div><div class=\"track\"><div class=\"bar ai\" style=\"width:${Math.max(.4,100*a/m.max)}%\"></div></div></div><div class=\"pair\"><b>${m.format(h)}</b><br><i>${m.format(a)}</i></div></div>`).join('');foot.textContent=m.note;document.querySelectorAll('.bw .chart-tabs button').forEach(btn=>{const selected=btn.dataset.metric===metric;btn.classList.toggle('active',selected);btn.setAttribute('aria-selected',selected?'true':'false')});}\n document.querySelectorAll('.bw .chart-tabs button').forEach(btn=>btn.addEventListener('click',()=>show(btn.dataset.metric)));show('quality');\n})();\n</script>\n",
      "comments": [],
      "created": "2026-09-24T09:15:14.876911+00:00",
