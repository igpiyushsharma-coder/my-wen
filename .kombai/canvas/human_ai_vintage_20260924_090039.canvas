      "themeId": null,
      "rect": {
        "x": 1380,
        "y": 0,
        "w": 1280,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap');\n  .ledger { font-family:'IBM Plex Sans',sans-serif; }\n  .editorial { font-family:'Fraunces',Georgia,serif; }\n  .ledger select,.ledger input { appearance:none; -webkit-appearance:none; }\n  .ledger input[type=number]::-webkit-inner-spin-button,.ledger input[type=number]::-webkit-outer-spin-button { -webkit-appearance:none;margin:0; }\n  .ledger input[type=number] { -moz-appearance:textfield; }\n  .ledger input:focus,.ledger select:focus { outline:2px solid #A6533B;outline-offset:3px; }\n  .ledger button:focus-visible { outline:2px solid #A6533B;outline-offset:3px; }\n  .ledger .primary-action { transition:background .18s ease,transform .18s ease,box-shadow .18s ease; }\n  .ledger .primary-action:hover { background:#90442F;transform:translateY(-1px);box-shadow:0 8px 20px rgba(59,48,40,.15); }\n  .ledger .nav-row { transition:background .18s ease,color .18s ease; }\n  .ledger .nav-row:hover { background:rgba(244,239,230,.07);color:#F4EFE6; }\n  @media (max-width: 900px) { .ledger .desktop-rail { display:none; } .ledger .mobile-bar { display:flex; } .ledger .main-area { padding-bottom:106px; } }\n  @media (max-width: 680px) { .ledger .main-area { padding:22px 18px 106px; } .ledger .page-heading { font-size:39px; } .ledger .top-actions { display:none; } .ledger .stage-label { font-size:10px; } .ledger .stage-track { gap:5px; } .ledger .stage-circle { width:27px;height:27px;font-size:10px; } .ledger .stage-line { margin:0 1px; } .ledger .input-grid { grid-template-columns:1fr; } .ledger .input-panel { padding:23px 20px; } .ledger .condition-grid { grid-template-columns:1fr; } .ledger .right-panel { padding:24px 22px; } .ledger .desktop-progress-label { display:none; } .ledger .stage-item { min-width:0; } }\n</style>\n<div class=\"ledger min-h-screen bg-[#F4EFE6] text-[#2B2925] flex antialiased selection:bg-[#D5BCA7]\" data-kid=\"1\">\n    <aside class=\"desktop-rail w-[252px] shrink-0 bg-[#3B3028] text-[#F4EFE6] min-h-screen flex flex-col border-r border-[#604C3D]\" data-kid=\"1-1\">\n        <div class=\"px-7 pt-8 pb-11 flex items-center gap-3\" data-kid=\"1-1-1\">\n            <div class=\"w-10 h-10 rounded-[11px] border border-[#B08D57]/50 flex items-center justify-center font-semibold text-[16px] tracking-[-.06em] text-[#F4EFE6]\" data-kid=\"1-1-1-1\">\n                H\n                <span class=\"mx-[2px] text-[#B08D57]\" data-kid=\"1-1-1-1-1\">\n                    ·\n                </span>\n                A\n            </div>\n            <div class=\"leading-[1.22]\" data-kid=\"1-1-1-2\">\n                <div class=\"editorial text-[17px] tracking-[-.03em]\" data-kid=\"1-1-1-2-1\">\n                    The Decision Ledger\n                </div>\n                <div class=\"text-[9px] uppercase tracking-[.21em] text-[#C4AC95] mt-[4px] font-semibold\" data-kid=\"1-1-1-2-2\">\n                    Workflow intelligence\n                </div>\n            </div>\n        </div>\n        <div class=\"px-7 mb-4 text-[10px] font-semibold tracking-[.15em] uppercase text-[#A99280]\" data-kid=\"1-1-2\">\n            Workspace\n        </div>\n        <nav aria-label=\"Primary navigation\" class=\"flex flex-col gap-1 px-4\" data-kid=\"1-1-3\">\n            <div class=\"nav-row h-[46px] px-3 rounded-[10px] flex gap-3 items-center text-[#C7B9A8] text-[13px] font-medium\" data-kid=\"1-1-3-1\">\n                <i data-kid=\"1-1-3-1-1\" data-lucide=\"layout-dashboard\" style=\"width:18px;height:18px;color:#C7B9A8\">\n                </i>\n                <span data-kid=\"1-1-3-1-2\">\n                    Dashboard\n                </span>\n            </div>\n            <div class=\"nav-row h-[46px] px-3 rounded-[10px] flex gap-3 items-center text-[#C7B9A8] text-[13px] font-medium\" data-kid=\"1-1-3-2\">\n                <i data-kid=\"1-1-3-2-1\" data-lucide=\"list-checks\" style=\"width:18px;height:18px;color:#C7B9A8\">\n                </i>\n                <span data-kid=\"1-1-3-2-2\">\n                    Tasks\n                </span>\n            </div>\n            <div class=\"h-[46px] px-3 rounded-[10px] flex gap-3 items-center text-[#F4EFE6] text-[13px] font-semibold bg-[#6D4D3B] relative\" data-kid=\"1-1-3-3\">\n                <span class=\"absolute left-0 top-[10px] bottom-[10px] w-[2px] rounded-full bg-[#B08D57]\" data-kid=\"1-1-3-3-1\">\n                </span>\n                <i data-kid=\"1-1-3-3-2\" data-lucide=\"scan-search\" style=\"width:18px;height:18px;color:#D9AB85\">\n                </i>\n                <span data-kid=\"1-1-3-3-3\">\n                    Analysis\n                </span>\n                <span class=\"ml-auto text-[#D9AB85] text-[10px]\" data-kid=\"1-1-3-3-4\" data-name=\"analysis task count badge\">\n                    02\n                </span>\n            </div>\n            <div class=\"nav-row h-[46px] px-3 rounded-[10px] flex gap-3 items-center text-[#C7B9A8] text-[13px] font-medium\" data-kid=\"1-1-3-4\">\n                <i data-kid=\"1-1-3-4-1\" data-lucide=\"database\" style=\"width:18px;height:18px;color:#C7B9A8\">\n                </i>\n                <span data-kid=\"1-1-3-4-2\">\n                    Data\n                </span>\n            </div>\n            <div class=\"nav-row h-[46px] px-3 rounded-[10px] flex gap-3 items-center text-[#C7B9A8] text-[13px] font-medium\" data-kid=\"1-1-3-5\">\n                <i data-kid=\"1-1-3-5-1\" data-lucide=\"sliders-horizontal\" style=\"width:18px;height:18px;color:#C7B9A8\">\n                </i>\n                <span data-kid=\"1-1-3-5-2\">\n                    Settings\n                </span>\n            </div>\n        </nav>\n        <div class=\"mt-auto mx-7 mb-8 pt-6 border-t border-[#6B584A]\" data-kid=\"1-1-4\">\n            <div class=\"flex items-center gap-2 text-[12px] text-[#E0CFBE] font-medium\" data-kid=\"1-1-4-1\">\n                <i data-kid=\"1-1-4-1-1\" data-lucide=\"flask-conical\" style=\"width:16px;height:16px;color:#B08D57\">\n                </i>\n                Sample data mode\n            </div>\n            <p class=\"text-[11px] leading-[1.55] text-[#A99280] mt-2\" data-kid=\"1-1-4-2\">\n                Recommendations are illustrative until real-world records are imported.\n            </p>\n        </div>\n    </aside>\n    <main class=\"main-area min-w-0 flex-1 max-w-[1600px] px-[48px] pt-[26px] pb-16\" data-kid=\"1-2\">\n        <header class=\"flex justify-between items-center border-b border-[#D8CCBA] pb-5\" data-kid=\"1-2-1\">\n            <div class=\"flex items-center gap-3 text-[12px] text-[#71675E]\" data-kid=\"1-2-1-1\">\n                <span class=\"font-semibold text-[#3B3028]\" data-kid=\"1-2-1-1-1\">\n                    Workspace\n                </span>\n                <i data-kid=\"1-2-1-1-2\" data-lucide=\"chevron-right\" style=\"width:14px;height:14px;color:#9B8A79\">\n                </i>\n                <span class=\"font-semibold text-[#A6533B]\" data-kid=\"1-2-1-1-3\">\n                    Analysis\n                </span>\n            </div>\n            <div class=\"top-actions flex items-center gap-3\" data-kid=\"1-2-1-2\">\n                <span class=\"inline-flex items-center gap-2 rounded-full border border-[#D5C7B2] px-3 py-[6px] text-[11px] font-medium text-[#685B4D]\" data-kid=\"1-2-1-2-1\">\n                    <i data-kid=\"1-2-1-2-1-1\" data-lucide=\"database\" style=\"width:13px;height:13px;color:#6F7352\">\n                    </i>\n                    Stored benchmarks\n                </span>\n                <span class=\"inline-flex items-center gap-2 rounded-full bg-[#E7DCCB] px-3 py-[6px] text-[11px] font-medium text-[#66594B]\" data-kid=\"1-2-1-2-2\">\n                    Sample data\n                </span>\n            </div>\n        </header>\n        <section class=\"flex items-end justify-between gap-8 pt-9 pb-7\" data-kid=\"1-2-2\">\n            <div data-kid=\"1-2-2-1\">\n                <div class=\"flex items-center gap-3 text-[10px] font-bold uppercase tracking-[.18em] text-[#A6533B] mb-3\" data-kid=\"1-2-2-1-1\">\n                    <span class=\"w-6 h-[1px] bg-[#A6533B]\" data-kid=\"1-2-2-1-1-1\">\n                    </span>\n                    Analysis workspace\n                    <span class=\"text-[#B6A99A]\" data-kid=\"1-2-2-1-1-2\">\n                        /\n                    </span>\n                    01\n                </div>\n                <h1 class=\"page-heading editorial text-[51px] leading-[1.02] tracking-[-.055em] text-[#302821]\" data-kid=\"1-2-2-1-2\">\n                    Analyze a task\n                    <span class=\"text-[#A6533B]\" data-kid=\"1-2-2-1-2-1\">\n                        .\n                    </span>\n                </h1>\n                <p class=\"text-[14px] leading-[1.65] text-[#6F655D] mt-3 max-w-[640px]\" data-kid=\"1-2-2-1-3\">\n                    Select a task and define your decision conditions. We’ll compare stored Human and AI evidence, then recommend the right workflow.\n                </p>\n            </div>\n            <div class=\"hidden xl:flex flex-col items-end pb-1 shrink-0\" data-kid=\"1-2-2-2\">\n                <div class=\"editorial text-[27px] tracking-[-.045em] text-[#3B3028]\" data-kid=\"1-2-2-2-1\">\n                    Human\n                    <span class=\"text-[#B08D57]\" data-kid=\"1-2-2-2-1-1\">\n                        /\n                    </span>\n                    AI\n                    <span class=\"text-[#B08D57]\" data-kid=\"1-2-2-2-1-2\">\n                        /\n                    </span>\n                    Hybrid\n                </div>\n                <div class=\"text-[11px] text-[#8C8175] mt-1 tracking-[.01em]\" data-kid=\"1-2-2-2-2\">\n                    The right workflow for the right task.\n                </div>\n            </div>\n        </section>\n        <section aria-label=\"Analysis stages\" class=\"rounded-[16px] border border-[#D9CEBD] bg-[#F8F5EF] px-[28px] py-[20px] mb-7 shadow-[0_5px_24px_rgba(59,48,40,.03)]\" data-kid=\"1-2-3\">\n            <div class=\"flex justify-between items-center mb-[18px]\" data-kid=\"1-2-3-1\">\n                <div class=\"text-[11px] uppercase font-bold tracking-[.15em] text-[#7B6D60]\" data-kid=\"1-2-3-1-1\">\n                    Analysis flow\n                </div>\n                <div class=\"desktop-progress-label text-[11px] text-[#8C8175]\" data-kid=\"1-2-3-1-2\">\n                    01 of 05\n                    <span class=\"mx-2 text-[#C5B8A7]\" data-kid=\"1-2-3-1-2-1\">\n                        ·\n                    </span>\n                    Set your conditions\n                </div>\n            </div>\n            <div class=\"stage-track flex items-start justify-between gap-2\" data-kid=\"1-2-3-2\">\n                <div class=\"stage-item flex flex-col items-center w-[114px] shrink-0\" data-kid=\"1-2-3-2-1\">\n                    <div class=\"stage-circle w-[33px] h-[33px] rounded-full flex items-center justify-center bg-[#A6533B] text-[#FFF8F0] text-[12px] font-semibold shadow-[0_2px_8px_rgba(166,83,59,.2)]\" data-kid=\"1-2-3-2-1-1\">\n                        01\n                    </div>\n                    <div class=\"stage-label mt-2 text-center text-[11px] leading-[1.2] font-semibold text-[#3B3028]\" data-kid=\"1-2-3-2-1-2\">\n                        Task input\n                    </div>\n                </div>\n                <div class=\"stage-line h-[1px] mt-[16px] grow bg-[#D8CCBA]\" data-kid=\"1-2-3-2-2\">\n                </div>\n                <div class=\"stage-item flex flex-col items-center w-[114px] shrink-0\" data-kid=\"1-2-3-2-3\">\n                    <div class=\"stage-circle w-[33px] h-[33px] rounded-full flex items-center justify-center border border-[#CDBDA8] bg-[#F4EFE6] text-[#9A8D7E] text-[11px] font-medium\" data-kid=\"1-2-3-2-3-1\">\n                        02\n                    </div>\n                    <div class=\"stage-label mt-2 text-center text-[11px] leading-[1.2] text-[#8C8175]\" data-kid=\"1-2-3-2-3-2\">\n                        Benchmark\n                    </div>\n                </div>\n                <div class=\"stage-line h-[1px] mt-[16px] grow bg-[#D8CCBA]\" data-kid=\"1-2-3-2-4\">\n                </div>\n                <div class=\"stage-item flex flex-col items-center w-[114px] shrink-0\" data-kid=\"1-2-3-2-5\">\n                    <div class=\"stage-circle w-[33px] h-[33px] rounded-full flex items-center justify-center border border-[#CDBDA8] bg-[#F4EFE6] text-[#9A8D7E] text-[11px] font-medium\" data-kid=\"1-2-3-2-5-1\">\n                        03\n                    </div>\n                    <div class=\"stage-label mt-2 text-center text-[11px] leading-[1.2] text-[#8C8175]\" data-kid=\"1-2-3-2-5-2\">\n                        Analysis\n                    </div>\n                </div>\n                <div class=\"stage-line h-[1px] mt-[16px] grow bg-[#D8CCBA]\" data-kid=\"1-2-3-2-6\">\n                </div>\n                <div class=\"stage-item flex flex-col items-center w-[114px] shrink-0\" data-kid=\"1-2-3-2-7\">\n                    <div class=\"stage-circle w-[33px] h-[33px] rounded-full flex items-center justify-center border border-[#CDBDA8] bg-[#F4EFE6] text-[#9A8D7E] text-[11px] font-medium\" data-kid=\"1-2-3-2-7-1\">\n                        04\n                    </div>\n                    <div class=\"stage-label mt-2 text-center text-[11px] leading-[1.2] text-[#8C8175]\" data-kid=\"1-2-3-2-7-2\">\n                        Comparison\n                    </div>\n                </div>\n                <div class=\"stage-line h-[1px] mt-[16px] grow bg-[#D8CCBA]\" data-kid=\"1-2-3-2-8\">\n                </div>\n                <div class=\"stage-item flex flex-col items-center w-[114px] shrink-0\" data-kid=\"1-2-3-2-9\">\n                    <div class=\"stage-circle w-[33px] h-[33px] rounded-full flex items-center justify-center border border-[#CDBDA8] bg-[#F4EFE6] text-[#9A8D7E] text-[11px] font-medium\" data-kid=\"1-2-3-2-9-1\">\n                        05\n                    </div>\n                    <div class=\"stage-label mt-2 text-center text-[11px] leading-[1.2] text-[#8C8175]\" data-kid=\"1-2-3-2-9-2\">\n                        Recommendation\n                    </div>\n                </div>\n            </div>\n        </section>\n        <div class=\"input-grid grid grid-cols-[minmax(0,1.62fr)_minmax(290px,1fr)] gap-5 items-start\" data-kid=\"1-2-4\">\n            <section class=\"input-panel rounded-[18px] bg-[#FFFCF7] border border-[#D8CCBA] p-[32px] shadow-[0_9px_27px_rgba(59,48,40,.045)]\" data-kid=\"1-2-4-1\">\n                <div class=\"flex items-start justify-between gap-4 pb-[21px] border-b border-[#E6DCCD]\" data-kid=\"1-2-4-1-1\">\n                    <div data-kid=\"1-2-4-1-1-1\">\n                        <div class=\"text-[10px] font-bold uppercase tracking-[.17em] text-[#A6533B] mb-[8px]\" data-kid=\"1-2-4-1-1-1-1\">\n                            01 / Input\n                        </div>\n                        <h2 class=\"editorial text-[26px] leading-tight tracking-[-.04em] text-[#342920]\" data-kid=\"1-2-4-1-1-1-2\">\n                            Set the decision conditions\n                        </h2>\n                        <p class=\"text-[12px] text-[#8C8175] mt-1\" data-kid=\"1-2-4-1-1-1-3\">\n                            Only three inputs are needed for the current analysis.\n                        </p>\n                    </div>\n                    <div class=\"w-9 h-9 shrink-0 rounded-[10px] border border-[#DED1C0] flex items-center justify-center bg-[#F4EFE6]\" data-kid=\"1-2-4-1-1-2\">\n                        <i data-kid=\"1-2-4-1-1-2-1\" data-lucide=\"settings-2\" style=\"width:18px;height:18px;color:#A6533B\">\n                        </i>\n                    </div>\n                </div>\n                <div class=\"pt-[23px]\" data-kid=\"1-2-4-1-2\">\n                    <label class=\"block text-[12px] font-semibold text-[#46392E] mb-[8px]\" data-kid=\"1-2-4-1-2-1\" for=\"ledger-task\">\n                        Task\n                        <span class=\"text-[#A6533B]\" data-kid=\"1-2-4-1-2-1-1\">\n                            *\n                        </span>\n                    </label>\n                    <div class=\"relative\" data-kid=\"1-2-4-1-2-2\">\n                        <select class=\"w-full h-[49px] rounded-[10px] border border-[#CFC1B0] bg-[#F7F1E8] pl-4 pr-12 text-[13px] font-medium text-[#342920] cursor-pointer\" data-kid=\"1-2-4-1-2-2-1\" id=\"ledger-task\">\n                            <option data-kid=\"1-2-4-1-2-2-1-1\" value=\"customer_email\">\n                                customer_email — Replying to a routine customer support email\n                            </option>\n                            <option data-kid=\"1-2-4-1-2-2-1-2\" value=\"data_extraction\">\n                                data_extraction — Extracting structured fields from a document\n                            </option>\n                            <option data-kid=\"1-2-4-1-2-2-1-3\" value=\"document_summary\">\n                                document_summary — Summarizing a business document\n                            </option>\n                        </select>\n                        <i class=\"pointer-events-none absolute right-[16px] top-[16px]\" data-kid=\"1-2-4-1-2-2-2\" data-lucide=\"chevron-down\" style=\"width:17px;height:17px;color:#66594B\">\n                        </i>\n                    </div>\n                    <p class=\"text-[11px] text-[#8C8175] mt-[9px] flex items-center gap-[7px]\" data-kid=\"1-2-4-1-2-3\">\n                        <i data-kid=\"1-2-4-1-2-3-1\" data-lucide=\"folder-open\" style=\"width:14px;height:14px;color:#6F7352\">\n                        </i>\n                        Customer Support\n                        <span class=\"text-[#C5B8A7]\" data-kid=\"1-2-4-1-2-3-2\">\n                            ·\n                        </span>\n                        Imported task benchmark\n                    </p>\n                </div>\n                <div class=\"condition-grid grid grid-cols-2 gap-4 mt-[26px]\" data-kid=\"1-2-4-1-3\">\n                    <div data-kid=\"1-2-4-1-3-1\">\n                        <label class=\"block text-[12px] font-semibold text-[#46392E] mb-[8px]\" data-kid=\"1-2-4-1-3-1-1\" for=\"ledger-volume\">\n                            Monthly task volume\n                            <span class=\"text-[#A6533B]\" data-kid=\"1-2-4-1-3-1-1-1\">\n                                *\n                            </span>\n                        </label>\n                        <div class=\"relative\" data-kid=\"1-2-4-1-3-1-2\">\n                            <input class=\"w-full h-[49px] rounded-[10px] border border-[#CFC1B0] bg-[#F7F1E8] px-4 pr-[70px] text-[15px] font-semibold tabular-nums text-[#342920]\" data-kid=\"1-2-4-1-3-1-2-1\" data-name=\"monthly task volume input\" id=\"ledger-volume\" min=\"0\" type=\"number\" value=\"10000\"/>\n                            <span class=\"absolute right-4 top-[16px] text-[11px] text-[#8C8175]\" data-kid=\"1-2-4-1-3-1-2-2\">\n                                / month\n                            </span>\n                        </div>\n                        <p class=\"mt-[8px] text-[11px] text-[#8C8175] leading-[1.4]\" data-kid=\"1-2-4-1-3-1-3\">\n                            Used to project the monthly savings range.\n                        </p>\n                    </div>\n                    <div data-kid=\"1-2-4-1-3-2\">\n                        <label class=\"block text-[12px] font-semibold text-[#46392E] mb-[8px]\" data-kid=\"1-2-4-1-3-2-1\" for=\"ledger-quality\">\n                            Minimum quality requirement\n                            <span class=\"text-[#A6533B]\" data-kid=\"1-2-4-1-3-2-1-1\">\n                                *\n                            </span>\n                        </label>\n                        <div class=\"relative\" data-kid=\"1-2-4-1-3-2-2\">\n                            <input class=\"w-full h-[49px] rounded-[10px] border border-[#CFC1B0] bg-[#F7F1E8] px-4 pr-12 text-[15px] font-semibold tabular-nums text-[#342920]\" data-kid=\"1-2-4-1-3-2-2-1\" data-name=\"minimum quality requirement input\" id=\"ledger-quality\" max=\"10\" min=\"0\" step=\"0.5\" type=\"number\" value=\"7.0\"/>\n                            <span class=\"absolute right-4 top-[16px] text-[11px] text-[#8C8175]\" data-kid=\"1-2-4-1-3-2-2-2\">\n                                / 10\n                            </span>\n                        </div>\n                        <p class=\"mt-[8px] text-[11px] text-[#8C8175] leading-[1.4]\" data-kid=\"1-2-4-1-3-2-3\">\n                            An option below this score cannot qualify.\n                        </p>\n                    </div>\n                </div>\n                <div class=\"rounded-[11px] bg-[#F4EFE6] border border-[#E5D8C8] flex gap-3 items-start px-4 py-[14px] mt-[28px]\" data-kid=\"1-2-4-1-4\">\n                    <i class=\"shrink-0 mt-[2px]\" data-kid=\"1-2-4-1-4-1\" data-lucide=\"info\" style=\"width:16px;height:16px;color:#6F7352\">\n                    </i>\n                    <p class=\"text-[11px] leading-[1.55] text-[#64584D]\" data-kid=\"1-2-4-1-4-2\">\n                        Human time, labor cost, AI model, API cost, processing time and quality rubric come from stored benchmark records. Update those through the Data page, not this form.\n                    </p>\n                </div>\n                <div class=\"flex flex-wrap items-center gap-5 border-t border-[#E6DCCD] mt-[27px] pt-[25px]\" data-kid=\"1-2-4-1-5\">\n                    <button class=\"primary-action inline-flex items-center gap-[11px] rounded-[10px] h-[47px] bg-[#A6533B] px-6 text-[13px] font-semibold text-[#FFF9F3]\" data-kid=\"1-2-4-1-5-1\" data-name=\"run analysis button\" type=\"button\">\n                        Run analysis\n                        <i data-kid=\"1-2-4-1-5-1-1\" data-lucide=\"arrow-right\" style=\"width:17px;height:17px;color:#FFF9F3\">\n                        </i>\n                    </button>\n                    <span class=\"text-[11px] text-[#8C8175]\" data-kid=\"1-2-4-1-5-2\">\n                        Compares existing Human and AI samples\n                    </span>\n                </div>\n            </section>\n            <aside class=\"right-panel rounded-[18px] bg-[#3B3028] text-[#F4EFE6] p-[28px] relative overflow-hidden shadow-[0_12px_28px_rgba(59,48,40,.12)]\" data-kid=\"1-2-4-2\">\n                <div class=\"absolute top-0 right-0 w-[135px] h-[1px] bg-[#B08D57]\" data-kid=\"1-2-4-2-1\">\n                </div>\n                <div class=\"flex items-center gap-2 text-[10px] uppercase font-bold tracking-[.16em] text-[#C7A67C] mb-[11px]\" data-kid=\"1-2-4-2-2\">\n                    <i data-kid=\"1-2-4-2-2-1\" data-lucide=\"database\" style=\"width:15px;height:15px;color:#C7A67C\">\n                    </i>\n                    Evidence in use\n                </div>\n                <h2 class=\"editorial text-[25px] leading-[1.1] tracking-[-.04em] mb-3\" data-kid=\"1-2-4-2-3\">\n                    A decision grounded\n                    <br data-kid=\"1-2-4-2-3-1\"/>\n                    in benchmarks.\n                </h2>\n                <p class=\"text-[12px] leading-[1.65] text-[#CFC0AF] mb-[24px]\" data-kid=\"1-2-4-2-4\">\n                    We compare the stored evidence for both approaches—not a hypothetical AI promise.\n                </p>\n                <div class=\"border-t border-[#69574A]\" data-kid=\"1-2-4-2-5\">\n                    <div class=\"py-[15px] flex gap-3 items-start border-b border-[#69574A]\" data-kid=\"1-2-4-2-5-1\">\n                        <div class=\"w-[7px] h-[7px] rounded-full bg-[#E1CFBA] mt-[6px] shrink-0\" data-kid=\"1-2-4-2-5-1-1\">\n                        </div>\n                        <div data-kid=\"1-2-4-2-5-1-2\">\n                            <div class=\"text-[12px] font-semibold\" data-kid=\"1-2-4-2-5-1-2-1\">\n                                Human benchmark\n                            </div>\n                            <div class=\"text-[11px] text-[#B8A897] mt-[3px]\" data-kid=\"1-2-4-2-5-1-2-2\">\n                                Labor cost · time · rubric quality\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"py-[15px] flex gap-3 items-start border-b border-[#69574A]\" data-kid=\"1-2-4-2-5-2\">\n                        <div class=\"w-[7px] h-[7px] rounded-full bg-[#879072] mt-[6px] shrink-0\" data-kid=\"1-2-4-2-5-2-1\">\n                        </div>\n                        <div data-kid=\"1-2-4-2-5-2-2\">\n                            <div class=\"text-[12px] font-semibold\" data-kid=\"1-2-4-2-5-2-2-1\">\n                                AI benchmark\n                            </div>\n                            <div class=\"text-[11px] text-[#B8A897] mt-[3px]\" data-kid=\"1-2-4-2-5-2-2-2\">\n                                API cost · time · rubric quality\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"py-[15px] flex gap-3 items-start\" data-kid=\"1-2-4-2-5-3\">\n                        <div class=\"w-[7px] h-[7px] rounded-full bg-[#BB725A] mt-[6px] shrink-0\" data-kid=\"1-2-4-2-5-3-1\">\n                        </div>\n                        <div data-kid=\"1-2-4-2-5-3-2\">\n                            <div class=\"text-[12px] font-semibold\" data-kid=\"1-2-4-2-5-3-2-1\">\n                                A quality-gated recommendation\n                            </div>\n                            <div class=\"text-[11px] text-[#B8A897] mt-[3px]\" data-kid=\"1-2-4-2-5-3-2-2\">\n                                Human, AI or a Hybrid workflow\n                            </div>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"mt-[14px] px-4 py-[13px] rounded-[10px] bg-[#4D4035] border border-[#665445]\" data-kid=\"1-2-4-2-6\">\n                    <p class=\"text-[11px] leading-[1.5] text-[#DDCDBA]\" data-kid=\"1-2-4-2-6-1\">\n                        <span class=\"text-[#E3C48D] font-semibold\" data-kid=\"1-2-4-2-6-1-1\">\n                            Sample data mode.\n                        </span>\n                        Example records illustrate the method; more real-world data can improve the decision.\n                    </p>\n                </div>\n            </aside>\n        </div>\n        <section class=\"mt-7 border-t border-[#D8CCBA] pt-[22px] flex flex-wrap items-start justify-between gap-4\" data-kid=\"1-2-5\">\n            <div data-kid=\"1-2-5-1\">\n                <div class=\"text-[10px] font-bold uppercase tracking-[.16em] text-[#A6533B] mb-2\" data-kid=\"1-2-5-1-1\">\n                    What happens next\n                </div>\n                <p class=\"editorial text-[20px] tracking-[-.03em] text-[#3B3028]\" data-kid=\"1-2-5-1-2\">\n                    Your comparison will appear here.\n                </p>\n            </div>\n            <p class=\"text-[11px] leading-[1.6] text-[#8C8175] max-w-[385px]\" data-kid=\"1-2-5-2\">\n                After analysis, review the overall result and the separate routine and complex cases. A Hybrid result is a recommended workflow, not a third measured benchmark.\n            </p>\n        </section>\n    </main>\n    <div class=\"mobile-bar fixed hidden bottom-0 inset-x-0 z-30 bg-[#3B3028] border-t border-[#6C5849] px-[10px] pb-[max(10px,env(safe-area-inset-bottom))] pt-[8px] items-center justify-between text-[#C8BAAA] shadow-[0_-6px_20px_rgba(43,41,37,.15)]\" data-kid=\"1-3\" data-name=\"mobile navigation bar\">\n        <div class=\"flex-1 flex flex-col items-center gap-[3px] text-[10px]\" data-kid=\"1-3-1\" data-name=\"navigation home tab\">\n            <i data-kid=\"1-3-1-1\" data-lucide=\"layout-dashboard\" style=\"width:18px;height:18px;color:#C8BAAA\">\n            </i>\n            Home\n        </div>\n        <div class=\"flex-1 flex flex-col items-center gap-[3px] text-[10px]\" data-kid=\"1-3-2\" data-name=\"navigation tasks tab\">\n            <i data-kid=\"1-3-2-1\" data-lucide=\"list-checks\" style=\"width:18px;height:18px;color:#C8BAAA\">\n            </i>\n            Tasks\n        </div>\n        <div class=\"flex-1 flex flex-col items-center gap-[3px] text-[10px] text-[#F4EFE6]\" data-kid=\"1-3-3\" data-name=\"navigation analysis tab\">\n            <i data-kid=\"1-3-3-1\" data-lucide=\"scan-search\" style=\"width:18px;height:18px;color:#D9AB85\">\n            </i>\n            Analysis\n        </div>\n        <div class=\"flex-1 flex flex-col items-center gap-[3px] text-[10px]\" data-kid=\"1-3-4\" data-name=\"navigation data tab\">\n            <i data-kid=\"1-3-4-1\" data-lucide=\"database\" style=\"width:18px;height:18px;color:#C8BAAA\">\n            </i>\n            Data\n        </div>\n        <div class=\"flex-1 flex flex-col items-center gap-[3px] text-[10px]\" data-kid=\"1-3-5\" data-name=\"navigation settings tab\">\n            <i data-kid=\"1-3-5-1\" data-lucide=\"sliders-horizontal\" style=\"width:18px;height:18px;color:#C8BAAA\">\n            </i>\n            Settings\n        </div>\n    </div>\n</div>\n<script src=\"https://unpkg.com/lucide@latest/dist/umd/lucide.min.js\">\n</script>\n<script>\n    if(window.lucide)lucide.createIcons();\n</script>\n",
